# Copy to .env and fill in. Never commit .env.

# Public hostname of the gateway, as the desktop app will call it.
#   Production:   llm.example.org          (Caddy serves HTTPS; see caddy/Caddyfile for TLS options)
#   Local dev:    http://localhost         (plain HTTP; set HTTP_PORT if 80 is taken)
GATEWAY_DOMAIN=http://localhost
HTTP_PORT=8080
HTTPS_PORT=8443

POSTGRES_PASSWORD=

# Admin-only. Must start with "sk-". Generate with: echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=
# Encrypts credentials LiteLLM stores in Postgres. Generate once, never change: openssl rand -hex 32
LITELLM_SALT_KEY=

# The --api-key each vLLM instance was started with.
VLLM_API_KEY=

# vLLM OpenAI-compatible base URLs (must end in /v1) and served model names ("hosted_vllm/" + the id
# from `curl <base>/v1/models`). Defaults point at the mock server (docker compose --profile mock).
# A vLLM on this machine (outside Docker): http://host.docker.internal:8000/v1 — not localhost,
# which inside the container is the container itself.
GEMMA_API_BASE=http://mock-vllm:8000/v1
GEMMA_MODEL=hosted_vllm/gemma
QWEN_API_BASE=http://mock-vllm:8000/v1
QWEN_MODEL=hosted_vllm/qwen
NEMOTRON_API_BASE=http://mock-vllm:8000/v1
NEMOTRON_MODEL=hosted_vllm/nemotron
